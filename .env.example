# Docker Compose treats "$" in values as a variable: wrap values that contain one
# (often passwords) in single quotes, e.g. QBITTORRENT_PASSWORD='pa$word'.

# Host path of the media folder (the same one qBittorrent mounts at /downloads)
MEDIA_PATH=/home/youruser/media

# User and group that Kinoarr runs as (Docker on Linux). They must be able to write
# into MEDIA_PATH to save subtitles; usually the same PUID/PGID as qBittorrent.
# Find yours with: id -u / id -g
PUID=1000
PGID=1000

# qBittorrent
QBITTORRENT_URL=http://qbittorrent:8081
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=change-me

# Prowlarr (Torznab API)
PROWLARR_URL=http://prowlarr:9696
PROWLARR_API_KEY=

# OpenSubtitles
OPENSUBTITLES_API_KEY=
# Optional: an opensubtitles.com account raises the daily download quota
# (about 5 downloads/day without it, 20 with a free account).
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=

# Path mapping: the downloads folder as qBittorrent sees it, and the same folder
# as Kinoarr sees it. Leave either empty if both see the same path.
# Example (qBittorrent native on Windows): QBITTORRENT_DOWNLOADS_PATH=D:\Torrents
QBITTORRENT_DOWNLOADS_PATH=/downloads
KINOARR_DOWNLOADS_PATH=/downloads

# Poller
POLL_INTERVAL=60

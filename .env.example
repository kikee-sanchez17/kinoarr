# Ruta en el host de la carpeta de medios (la misma que monta qBittorrent en /downloads)
MEDIA_PATH=/home/youruser/media

# qBittorrent
QBIT_URL=http://qbittorrent:8081
QBIT_USERNAME=admin
QBIT_PASSWORD=change-me

# Jellyfin (network_mode: host -> se accede vía host.docker.internal)
JELLYFIN_URL=http://host.docker.internal:8096
JELLYFIN_API_KEY=

# Prowlarr (API Torznab)
PROWLARR_URL=http://prowlarr:9696
PROWLARR_API_KEY=

# APIs externas
TMDB_API_KEY=
OPENSUBTITLES_API_KEY=

# Idiomas de subtítulos, separados por comas
SUBTITLE_LANGUAGES=en

# Rutas y poller
DOWNLOADS_PATH=/downloads
POLL_INTERVAL=60
